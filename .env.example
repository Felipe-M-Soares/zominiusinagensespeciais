# ─── Obrigatórias (frontend) ────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Nunca coloque a service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Opcionais ───────────────────────────────────────────────────────────────
# Dados da empresa impressos em PDFs de pedido/orçamento
VITE_COMPANY_NAME=Zomini Usinagens Especiais
VITE_COMPANY_DOCUMENT=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_PHONE=
VITE_COMPANY_EMAIL=
# Nome exibido em "Sobre o sistema"
VITE_LICENSED_TO=
# Monitoramento de erros (Sentry). Vazio = desativado.
VITE_SENTRY_DSN=
# Mostra o card "Saúde do sistema" no dashboard do admin
VITE_ENABLE_SYSTEM_HEALTH=false

# ─── Somente na Vercel (Settings → Environment Variables) ───────────────────
# Protege o endpoint /api/keep-alive chamado pelo Vercel Cron
CRON_SECRET=
