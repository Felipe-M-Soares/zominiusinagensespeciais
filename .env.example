# Supabase - copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no git

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui

# URL canônica do site em produção (usado no OAuth redirect e links de email)
# Deve ser https:// em produção. Ex: https://conceptusinagensespeciais-lac.vercel.app
VITE_SITE_URL=https://seu-dominio.vercel.app

# Sentry error monitoring (opcional — deixe vazio para desativar)
# Crie um projeto em https://sentry.io e cole o DSN aqui
VITE_SENTRY_DSN=

# --- Edge Functions (configurar no painel do Supabase > Project Settings > Edge Functions) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# → preenchidos automaticamente pelo Supabase. Não precisam ser configurados manualmente.

# Origem permitida para CORS das Edge Functions (deve ser igual ao VITE_SITE_URL)
# Configurar em: Supabase > Project Settings > Edge Functions > Secrets
ALLOWED_ORIGIN=https://seu-dominio.vercel.app

# Ativar logs detalhados nas Edge Functions (nunca usar em produção)
DEBUG=false
