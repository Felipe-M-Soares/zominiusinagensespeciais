# Manutenção mensal: limpa audit_log com mais de 90 dias
name: Maintenance

on:
  schedule:
    - cron: '0 3 1 * *'  # Todo dia 1 de cada mês às 3h UTC
  workflow_dispatch:       # Permite rodar manualmente

jobs:
  cleanup:
    name: Cleanup audit_log
    runs-on: ubuntu-latest
    steps:
      - name: Run cleanup via Supabase REST API
        run: |
          curl -s -X POST \
            "${{ secrets.VITE_SUPABASE_URL }}/rest/v1/rpc/cleanup_audit_log" \
            -H "Authorization: Bearer ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}" \
            -H "Content-Type: application/json" \
            -d '{}'
          echo "Cleanup executado com sucesso"
